{
  "manifest_version": 3,
  "name": "Essence",
  "version": "0.3.1",
  "description": "Извлича същността на дълги текстове при поискване и се учи от локалните ви оценки.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "src/background.js",
    "type": "module"
  },
  "icons": {
    "16": "icons/target-16.png",
    "32": "icons/target-32.png",
    "48": "icons/target-48.png",
    "128": "icons/target-128.png"
  },
  "action": {
    "default_title": "Essence",
    "default_popup": "src/popup.html",
    "default_icon": {
      "16": "icons/target-16.png",
      "32": "icons/target-32.png"
    }
  },
  "options_page": "src/options.html",
  "content_scripts": [
    {
      "matches": [
        "<all_urls>"
      ],
      "js": [
        "src/detect.js",
        "src/content.js"
      ],
      "run_at": "document_idle"
    }
  ],
  "web_accessible_resources": [
    {
      "resources": [
        "src/shared.js"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
